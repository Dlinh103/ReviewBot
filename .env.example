APP_ENV=dev
LOG_LEVEL=INFO

# GitHub App Configuration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=

# LLM Configuration
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60

# Infrastructure
DATABASE_URL=postgresql+psycopg://reviewbot:reviewbot@localhost:5432/reviewbot
REDIS_URL=redis://localhost:6379/0

# Review Settings
MAX_FILES_PER_PR=40
MAX_DIFF_TOKENS_PER_CHUNK=6000
MAX_COMMENTS_PER_PR=15
MIN_CONFIDENCE=0.6
REVIEW_DRAFT_PRS=false
OUTPUT_LANGUAGE=vi
